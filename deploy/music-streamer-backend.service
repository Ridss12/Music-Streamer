[Unit]
Description=Music Streamer FastAPI backend
Wants=network-online.target
After=network-online.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=ved
WorkingDirectory=/home/ved/Projects/Music-Streamer/backend
EnvironmentFile=/home/ved/Projects/Music-Streamer/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ved/Projects/Music-Streamer/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
