# Comma-separated browser origins allowed to call the backend.
# Replace with the exact Cloudflare Pages production origin and any preview origins you use.
CORS_ORIGINS=https://your-site.pages.dev,https://your-custom-domain.example

# Keep database credentials and JWT secrets in this local file, not in Cloudflare Pages.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=music_app
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=music_streamer
JWT_SECRET_KEY=replace-with-a-long-random-secret
