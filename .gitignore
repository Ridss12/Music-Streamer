# Python virtual environments
**/venv/
**/.venv/
**/venv-linux/
**/venv-windows/
**/venv-*/

# Python cache
**/__pycache__/
*.py[cod]

# Node.js
**/node_modules/
**/dist/
.wrangler/

# User-managed audio library (kept on the host PC)
/backend/songs/

# Environment secrets
.env
.env.*
!.env.example

# Local database
/backend/music_streamer.db
/backend/music_streamer.db.pre-mysql-backup

# Logs
*.log

# Rasa cache and trained models
**/.rasa/
**/models/
# Keep backend SQLAlchemy models; the rule above is for generated model folders.
!backend/app/models/
!backend/app/models/**
backend/app/models/**/__pycache__/
backend/app/models/**/*.pyc

# OS files
.DS_Store
Thumbs.db
